{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "impactLevel": {
          "type": "string",
          "enum": ["high", "moderate", "low"],
          "default": "high"
        },
        "executionMode": {
          "type": "string",
          "enum": ["dryRun", "observe", "enforce"],
          "default": "dryRun"
        },
        "fips": {
          "type": "boolean",
          "default": true
        },
        "requireAdmissionController": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "admissionController": {
          "type": "string",
          "enum": ["kyverno", "opa"]
        },
        "signatureVerifier": {
          "type": "string",
          "enum": ["kyverno", "policy-controller"]
        },
        "detectionBackend": {
          "type": "string",
          "enum": ["falco", "tetragon", "none"]
        },
        "cniObservability": {
          "type": "string",
          "enum": ["hubble", "calico", "tcp-inference"]
        }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "intervalSeconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 86400
        },
        "netpol": {
          "type": "object",
          "properties": {
            "defaultTargetHost": {
              "type": "string"
            },
            "defaultTargetPort": {
              "type": "string"
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "retentionDays": {
          "type": "integer",
          "minimum": 180
        },
        "failClosedOnExportFailure": {
          "type": "boolean"
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "customProbes": {
      "type": "object",
      "properties": {
        "serviceAccounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              },
              "namespace": {
                "type": "string",
                "const": "sidereal-system"
              }
            }
          }
        }
      }
    },
    "crosswalk": {
      "type": "object",
      "properties": {
        "installDefaults": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
